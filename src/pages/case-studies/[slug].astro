---
import Base from "../../layouts/Base.astro";
import { caseStudies } from "../../data/caseStudies";

export function getStaticPaths() {
	return caseStudies.map((study, index) => ({
		params: { slug: study.slug },
		props: {
			study,
			prev: caseStudies[(index - 1 + caseStudies.length) % caseStudies.length],
			next: caseStudies[(index + 1) % caseStudies.length],
		},
	}));
}

const { study, prev, next } = Astro.props;
---

<Base title={`${study.title} — Fraser Page`}>
	<nav class="case-crumbs">
		<a href="/">&larr; Back to Home</a>
		<span class="crumb-sep">/</span>
		<details class="case-switcher">
			<summary>Recent Work</summary>
			<ul>
				{caseStudies.map((cs) => (
					<li>
						<a href={`/case-studies/${cs.slug}/`} aria-current={cs.slug === study.slug ? "page" : undefined}>
							<span class="switcher-no">{cs.no}</span>{cs.title}
						</a>
					</li>
				))}
			</ul>
		</details>
	</nav>

	<div class="case-header">
		<div class="label">{study.no} &mdash; {study.tag}</div>
		<h1>{study.title}</h1>
	</div>

	<div class="case-body">
		{study.blocks.map((block) => {
			if (block.h) {
				return <h3>{block.h}</h3>;
			}
			if (block.p) {
				return <p>{block.p}</p>;
			}
			if (block.visual === "tasks") {
				return (
					<figure class="visual visual-shot">
						<img
							src="/images/grace/student-tasks.png"
							width="1024"
							height="1862"
							alt="Student home screen grouping tasks into not approved, overdue, due soon, and to-do"
						/>
					</figure>
				);
			}
			if (block.visual === "notes") {
				return (
					<figure class="visual visual-shot">
						<video
							src="/images/grace/fill-fields-from-notes.mp4"
							width="978"
							height="1612"
							muted
							loop
							playsinline
							preload="metadata"
							aria-label="Add Interaction form: clicking Fill fields from notes infers topics and types from the adviser's notes"
						></video>
						<button type="button" class="visual-shot-toggle" aria-pressed="true">Pause</button>
					</figure>
				);
			}
			if (block.visual === "sms") {
				return (
					<div class="visual">
						<svg viewBox="0 0 480 200" role="img" aria-label="Comparison of a rigid script message versus an AI prompt message">
							<text x="70" y="20" text-anchor="middle" font-size="10" letter-spacing="1" fill="var(--muted)">SCRIPT</text>
							<rect x="10" y="32" width="200" height="158" fill="none" stroke="var(--border)" stroke-width="1"></rect>
							<rect x="24" y="54" width="172" height="66" fill="none" stroke="var(--border)" stroke-width="1"></rect>
							<text font-size="10" fill="var(--fg)">
								<tspan x="34" y="73">Reminder: complete</tspan>
								<tspan x="34" y="87">your application by</tspan>
								<tspan x="34" y="101">the deadline.</tspan>
							</text>
							<text x="34" y="140" font-size="9" fill="var(--muted)">Same message,</text>
							<text x="34" y="152" font-size="9" fill="var(--muted)">every student.</text>
							<text x="410" y="20" text-anchor="middle" font-size="10" letter-spacing="1" fill="var(--muted)">PROMPT</text>
							<rect x="270" y="32" width="200" height="158" fill="none" stroke="var(--border)" stroke-width="1"></rect>
							<rect x="284" y="54" width="172" height="82" fill="none" stroke="var(--border)" stroke-width="1"></rect>
							<text font-size="10" fill="var(--fg)">
								<tspan x="294" y="71">Hi Maria — you're close</tspan>
								<tspan x="294" y="85">to finishing your Ohio</tspan>
								<tspan x="294" y="99">State application. Want</tspan>
								<tspan x="294" y="113">help with the last part?</tspan>
							</text>
							<text x="294" y="152" font-size="9" fill="var(--muted)">Written per student,</text>
							<text x="294" y="164" font-size="9" fill="var(--muted)">from their actual data.</text>
						</svg>
					</div>
				);
			}
			return null;
		})}
	</div>

	<div class="case-pager">
		<a href={`/case-studies/${prev.slug}/`}>&larr; {prev.no} &mdash; {prev.title}</a>
		<a href={`/case-studies/${next.slug}/`}>{next.no} &mdash; {next.title} &rarr;</a>
	</div>
</Base>

<style>
	.case-crumbs {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.8rem;
		margin-bottom: 3rem;
	}

	.case-crumbs > a {
		text-decoration: none;
		color: var(--muted);
	}

	.case-crumbs > a:hover {
		color: var(--fg);
	}

	.crumb-sep {
		color: var(--border);
	}

	.case-switcher {
		position: relative;
	}

	.case-switcher summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--accent);
		font-variation-settings: "MONO" 1, "wght" 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.case-switcher summary::-webkit-details-marker {
		display: none;
	}

	.case-switcher summary::after {
		content: "";
		width: 0;
		height: 0;
		border-left: 4px solid transparent;
		border-right: 4px solid transparent;
		border-top: 5px solid currentColor;
		transition: transform 0.15s ease;
	}

	.case-switcher[open] summary::after {
		transform: rotate(180deg);
	}

	.case-switcher ul {
		position: absolute;
		top: calc(100% + 0.6rem);
		left: 0;
		min-width: 15rem;
		background: var(--bg);
		border: 1px solid var(--border);
		list-style: none;
		margin: 0;
		padding: 0.35rem 0;
		z-index: 10;
	}

	.case-switcher li a {
		display: flex;
		gap: 0.6rem;
		padding: 0.5rem 0.9rem;
		text-decoration: none;
		color: var(--fg);
		font-size: 0.85rem;
		white-space: nowrap;
	}

	.case-switcher li a:hover {
		background: var(--border);
	}

	.case-switcher li a[aria-current="page"] {
		font-variation-settings: "wght" 600;
		color: var(--accent);
	}

	.switcher-no {
		font-variation-settings: "MONO" 1;
		color: var(--muted);
	}

	.case-header {
		max-width: 42rem;
		margin-bottom: 3.5rem;
	}

	.case-header .label {
		color: var(--accent);
		display: block;
		margin-bottom: 0.9rem;
	}

	.case-header h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		font-variation-settings: "wght" 600;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.case-body {
		max-width: clamp(38rem, 80vw, 52rem);
		margin-bottom: 4rem;
	}

	.case-body h3 {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-variation-settings: "wght" 600, "MONO" 1;
		color: var(--muted);
		margin: 2.25rem 0 0.9rem;
	}

	.case-body h3:first-child {
		margin-top: 0;
	}

	.case-body p {
		margin: 0 0 1.1rem;
		font-size: 1rem;
		line-height: 1.7;
	}

	.visual {
		margin: 1.75rem 0 2rem;
		max-width: 34rem;
	}

	.visual svg,
	.visual img,
	.visual video {
		width: 100%;
		height: auto;
		display: block;
	}

	.visual-shot {
		max-width: 30rem;
		margin: 1.75rem 0 2rem;
	}

	.visual-shot img,
	.visual-shot video {
		border: 1px solid var(--border);
	}

	.visual-shot video {
		cursor: pointer;
	}

	.visual-shot-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		min-width: 44px;
		margin-top: 0.55rem;
		padding: 0 0.15rem;
		font: inherit;
		font-size: 0.78rem;
		font-variation-settings: "MONO" 1, "wght" 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
		background: none;
		border: none;
		cursor: pointer;
	}

	.visual-shot-toggle:hover,
	.visual-shot-toggle:focus-visible {
		color: var(--fg);
	}

	.visual-shot-toggle:focus-visible {
		outline: 1px dashed var(--fg);
		outline-offset: 4px;
	}

	.visual-shot.is-paused .visual-shot-toggle {
		color: var(--accent);
	}

	.case-pager {
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		font-size: 0.85rem;
	}

	.case-pager a {
		text-decoration: none;
	}

	.case-pager a:last-child {
		font-variation-settings: "wght" 600;
		color: var(--accent);
	}

	.case-pager a:first-child {
		color: var(--muted);
	}

	@media (max-width: 560px) {
		.case-pager {
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll(".visual-shot").forEach((shot) => {
		const video = shot.querySelector("video");
		const button = shot.querySelector(".visual-shot-toggle");
		if (!(video instanceof HTMLVideoElement) || !(button instanceof HTMLButtonElement)) return;

		function sync() {
			const paused = video.paused;
			shot.classList.toggle("is-paused", paused);
			button.textContent = paused ? "Play" : "Pause";
			button.setAttribute("aria-pressed", String(!paused));
		}

		function toggle() {
			if (video.paused) {
				video.play().catch(() => {});
			} else {
				video.pause();
			}
		}

		button.addEventListener("click", toggle);
		video.addEventListener("click", toggle);
		video.addEventListener("play", sync);
		video.addEventListener("pause", sync);

		if (!reduceMotion) {
			video.play().catch(() => {});
		}

		sync();
	});
</script>
