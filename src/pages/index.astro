				<line x1="150" y1="37" x2="290" y2="37" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3"></line>
				<text x="300" y="42" font-family="Recursive" font-size="10" fill="var(--muted)">financial_aid_status = submitted</text>

				<text x="0" y="76" font-family="Recursive" font-size="11" fill="var(--fg)">&#9744; Send transcript</text>
				<line x1="150" y1="71" x2="290" y2="71" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3"></line>
