		<template id="visual-notes">
			<svg viewBox="0 0 480 150" role="img" aria-label="Diagram of an adviser note being transformed into a filled interaction form via AI smart-fill">
				<text x="0" y="16" font-family="Recursive" font-size="9.5" letter-spacing="1" fill="var(--muted)">ADVISER NOTES</text>
				<rect x="0" y="26" width="190" height="90" fill="none" stroke="var(--line)" stroke-width="1"></rect>
				<text font-family="Recursive" font-size="10" fill="var(--fg)">
					<tspan x="12" y="48">talked to sarah, fafsa</tspan>
					<tspan x="12" y="63">deadline coming up,</tspan>
					<tspan x="12" y="78">seemed stressed</tspan>
				</text>

				<text x="230" y="76" text-anchor="middle" font-family="Recursive" font-size="9.5" fill="var(--muted)">smart-fill &#8594;</text>

				<text x="290" y="16" font-family="Recursive" font-size="9.5" letter-spacing="1" fill="var(--muted)">INTERACTION FORM</text>
				<rect x="290" y="26" width="190" height="90" fill="none" stroke="var(--line)" stroke-width="1"></rect>
				<text font-family="Recursive" font-size="9.5" fill="var(--fg)">
					<tspan x="302" y="45">Type: Advising call</tspan>
					<tspan x="302" y="63">Topic: FAFSA deadline</tspan>
					<tspan x="302" y="81">Follow-up: Yes</tspan>
					<tspan x="302" y="99">Mood: Stressed</tspan>
				</text>

				<text x="0" y="138" font-family="Recursive" font-size="9" fill="var(--muted)">A few words in, a structured record out — one button.</text>
			</svg>
		</template>

		<script define:vars={{ caseStudies }}>
			const traitSelect = document.getElementById("trait-select");

			traitSelect?.addEventListener("change", () => {
				try {
					localStorage.setItem("fp:trait", traitSelect.value);
				} catch (e) {}
			});

			try {
				const savedTrait = localStorage.getItem("fp:trait");
				if (savedTrait) traitSelect.value = savedTrait;
			} catch (e) {}

			const root = document.documentElement;
			const themeButtons = document.querySelectorAll("[data-theme-choice]");

			function applyTheme(mode) {
				if (mode === "light" || mode === "dark") {
					root.setAttribute("data-theme", mode);
				} else {
					root.removeAttribute("data-theme");
				}
				themeButtons.forEach((b) => {
					b.setAttribute("aria-current", String(b.getAttribute("data-theme-choice") === mode));
				});
				try {
					localStorage.setItem("fp:theme", mode);
				} catch (e) {}
			}

			themeButtons.forEach((b) => {
				b.addEventListener("click", () => applyTheme(b.getAttribute("data-theme-choice")));
			});

			try {
				const savedTheme = localStorage.getItem("fp:theme");
				if (savedTheme) applyTheme(savedTheme);
			} catch (e) {}

			// Window manager: independent, draggable, resizable floating windows
			const openWindows = new Map();
			let zTop = 10;
			let cascadeIndex = 0;

			function bringToFront(el) {
				zTop += 1;
				el.style.zIndex = String(zTop);
			}

			function renderBody(container, c) {
				const tagEl = document.createElement("span");
				tagEl.className = "win-tag";
				tagEl.textContent = c.tag;
				container.appendChild(tagEl);

				c.blocks.forEach((block) => {
					if (block.h) {
						const h = document.createElement("h4");
						h.textContent = block.h;
						container.appendChild(h);
					} else if (block.p) {
						const p = document.createElement("p");
						p.textContent = block.p;
						container.appendChild(p);
					} else if (block.visual) {
						const wrap = document.createElement("div");
						wrap.className = "win-visual";
						const tpl = document.getElementById("visual-" + block.visual);
						if (tpl) wrap.appendChild(tpl.content.cloneNode(true));
						container.appendChild(wrap);
					}
				});
			}

			function buildWindow(index) {
				const c = caseStudies[index];
				const el = document.createElement("div");
				el.className = "win";
				el.setAttribute("role", "dialog");
				el.setAttribute("aria-label", c.title);

				const wPx = Math.min(window.innerWidth * 0.8, 640);
				const hPx = window.innerHeight * 0.8;
				const offset = (cascadeIndex % 6) * 28;
				cascadeIndex += 1;

				el.style.width = wPx + "px";
				el.style.height = hPx + "px";
				el.style.left = Math.max(8, (window.innerWidth - wPx) / 2 + offset) + "px";
				el.style.top = Math.max(8, (window.innerHeight - hPx) / 2 + offset) + "px";

				const titlebar = document.createElement("div");
				titlebar.className = "win-titlebar";
				titlebar.innerHTML =
					'<div class="win-controls">' +
						'<button type="button" data-action="close" aria-label="Close"></button>' +
						'<button type="button" data-action="maximize" aria-label="Maximize"></button>' +
					"</div>" +
					'<span class="win-title">' + c.no + " — " + c.title + "</span>";
				el.appendChild(titlebar);

				const body = document.createElement("div");
				body.className = "win-body";
				renderBody(body, c);
				el.appendChild(body);

				["n", "s", "e", "w", "ne", "nw", "se", "sw"].forEach((dir) => {
					const h = document.createElement("div");
					h.className = "resize-handle rh-" + dir;
					h.dataset.dir = dir;
					el.appendChild(h);
				});

				document.body.appendChild(el);
				bringToFront(el);
				el.addEventListener("pointerdown", () => bringToFront(el));

				let restoreRect = null;

				el.querySelector('[data-action="close"]').addEventListener("click", () => {
					openWindows.delete(index);
					el.remove();
				});

				el.querySelector('[data-action="maximize"]').addEventListener("click", () => {
					if (!restoreRect) {
						restoreRect = {
							top: el.style.top,
							left: el.style.left,
							width: el.style.width,
							height: el.style.height,
						};
						el.style.top = "3vh";
						el.style.left = "3vw";
						el.style.width = "94vw";
						el.style.height = "94vh";
					} else {
						el.style.top = restoreRect.top;
						el.style.left = restoreRect.left;
						el.style.width = restoreRect.width;
						el.style.height = restoreRect.height;
						restoreRect = null;
					}
				});

				titlebar.addEventListener("pointerdown", (e) => {
					if (e.target.closest("button")) return;
					bringToFront(el);
					const startX = e.clientX;
					const startY = e.clientY;
					const startTop = el.offsetTop;
					const startLeft = el.offsetLeft;
					restoreRect = null;

					function onMove(ev) {
						el.style.left = startLeft + (ev.clientX - startX) + "px";
						el.style.top = Math.max(0, startTop + (ev.clientY - startY)) + "px";
					}
					function onUp() {
						document.removeEventListener("pointermove", onMove);
						document.removeEventListener("pointerup", onUp);
					}
					document.addEventListener("pointermove", onMove);
					document.addEventListener("pointerup", onUp);
				});

				el.querySelectorAll(".resize-handle").forEach((handle) => {
					handle.addEventListener("pointerdown", (e) => {
						e.preventDefault();
						e.stopPropagation();
						bringToFront(el);
						const dir = handle.dataset.dir;
						const startX = e.clientX;
						const startY = e.clientY;
						const startW = el.offsetWidth;
						const startH = el.offsetHeight;
						const startTop = el.offsetTop;
						const startLeft = el.offsetLeft;
						restoreRect = null;

						function onMove(ev) {
							const dx = ev.clientX - startX;
							const dy = ev.clientY - startY;
							if (dir.includes("e")) el.style.width = Math.max(288, startW + dx) + "px";
							if (dir.includes("s")) el.style.height = Math.max(160, startH + dy) + "px";
							if (dir.includes("w")) {
								const nw = Math.max(288, startW - dx);
								el.style.width = nw + "px";
								el.style.left = startLeft + (startW - nw) + "px";
							}
							if (dir.includes("n")) {
								const nh = Math.max(160, startH - dy);
								el.style.height = nh + "px";
								el.style.top = startTop + (startH - nh) + "px";
							}
						}
						function onUp() {
							document.removeEventListener("pointermove", onMove);
							document.removeEventListener("pointerup", onUp);
						}
						document.addEventListener("pointermove", onMove);
						document.addEventListener("pointerup", onUp);
					});
				});

				document.addEventListener("keydown", function escHandler(e) {
					if (e.key === "Escape" && document.body.contains(el)) {
						el.remove();
						openWindows.delete(index);
						document.removeEventListener("keydown", escHandler);
					}
				});

				return el;
			}

			document.querySelectorAll(".case-row").forEach((row) => {
				row.addEventListener("click", () => {
					const index = Number(row.dataset.caseIndex);
					if (openWindows.has(index)) {
						bringToFront(openWindows.get(index));
						return;
					}
					const el = buildWindow(index);
					openWindows.set(index, el);
				});
			});
		</script>
	</body>
</html>
