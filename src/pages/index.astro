---
const traits = ["Creative", "Product-minded", "Thoughtful", "Data-driven", "AI-native"];
const roles = ["developer", "builder", "engineer"];

const caseStudies = [
  {
    no: "01",
    title: "Data Requests",
    tag: "AI tool design",
    summary: "Students submit data changes as diffs; advisers approve before merge.",
    body: "First attempt gave the AI agent the backend's own data shape as its tool interface. Testing showed it conflating things it shouldn't — application status with data-submission status. The fix: tools need their own shape, not the backend's. Simplified the surface to only what the agent and student actually need to know.",
    img: "/images/grace.jpg",
  },
  {
    no: "02",
    title: "Smart Interaction",
    tag: "Feature craft",
    summary: "A vague brief — “make interaction-logging better.”",
    body: "Usage data showed advisers batching entries, reopening the same form over and over. Built for three habits at once: extended bulk-import to fully support interactions via a table view; a “keep window open” toggle for dialog-flow advisers; and AI smart-fill from notes for single entry — reading adviser docs baked into the agent, filtered to exclude student names, on the fastest model that held up under testing.",
    img: "/images/grace.jpg",
  },
  {
    no: "03",
    title: "Tasks system",
    tag: "Greenfield",
    summary: "A new student portal needed “tasks” — nobody could define what that meant.",
    body: "Client couldn't articulate it, the designer lacked workflow context. Reasoning: the platform's job is data collection, so tasks should represent journey steps completed by updating data, not a checklist disconnected from it. Built v1 hardcoded, shaped to expose the existing filtering tools as a config screen later.",
    img: "/images/grace.jpg",
  },
  {
    no: "04",
    title: "Scripts to prompts",
    tag: "Strategic reframe",
    summary: "Brief: replace a clunky, expensive external SMS platform.",
    body: "The client was stuck thinking in “scripts.” Reframed to AI-driven “prompts” triggered by live student data changes — not just fulfilling the brief as given.",
    img: "/images/grace.jpg",
  },
];

const heritage = [
  {
    img: "/images/translash.jpeg",
    title: "TransLash",
    year: "2024",
    detail: "Lead developer on a bold new site designed by Alix Hopfengaertner-Vigneault and Kaila Jacques. 2025 Webby Award. Legislation-tracking dashboard pulling daily from an external API into interactive D3 charts.",
    link: "https://translash.org/",
  },
  {
    img: "/images/acumen.jpg",
    title: "Acumen",
    year: "2023",
    detail: "Custom WordPress REST API and a multi-component Vue.js map app for global programs and portfolio companies.",
    link: "https://acumen.org/where-we-work/",
  },
  {
    img: "/images/artsmidwest.jpeg",
    title: "Arts Midwest",
    year: "2023",
    detail: "Award-winning site; custom REST API powering an interactive SVG grantee-impact map.",
    link: "https://artsmidwest.org/impact/",
  },
];

const personal = [
  {
    img: "/images/wedding.png",
    title: "Wedding RSVP",
    detail: "A playful RSVP site for my own wedding — save-as-you-go forms, custom guest links, a heart you can shoot an arrow through to make us kiss.",
    link: "https://kasia-fraser.love/rsvp/v4jXBVDBjTyz7YDY9vDxVjmm",
  },
  {
    img: "/images/spf.jpeg",
    title: "Chart labels that don't overlap",
    detail: "When Chart.js couldn't place doughnut-chart labels without overlap, I wrote the placement geometry myself.",
    link: "https://helpstpauls.com/annual-report/#by-the-numbers",
  },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Fraser Page</title>
		<style>
			@font-face {
				font-family: "Recursive";
				font-style: normal;
				font-weight: 300 1000;
				font-display: swap;
				src: url("/fonts/recursive-latin.woff2") format("woff2");
			}

			:root {
				--bg: #ffffff;
				--fg: #111111;
				--muted: #5a5a5a;
				--line: #111111;
			}

			:root[data-theme="dark"] {
				--bg: #111111;
				--fg: #f0f0f0;
				--muted: #a3a3a3;
				--line: #f0f0f0;
			}

			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) {
					--bg: #111111;
					--fg: #f0f0f0;
					--muted: #a3a3a3;
					--line: #f0f0f0;
				}
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
			}

			body {
				font-family: "Recursive", ui-sans-serif, system-ui, sans-serif;
				font-variation-settings: "wght" 380, "MONO" 0, "CASL" 0;
				font-size: 16px;
				line-height: 1.55;
				padding: 2.5rem 2rem 6rem;
			}

			a {
				color: inherit;
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			.topbar {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				border-bottom: 1px solid var(--line);
				padding-bottom: 1.25rem;
				margin-bottom: 4.5rem;
				font-size: 0.8rem;
				letter-spacing: 0.02em;
			}

			.topbar-name {
				font-variation-settings: "wght" 700;
			}

			.theme-links button {
				font: inherit;
				background: none;
				border: none;
				color: inherit;
				cursor: pointer;
				padding: 0;
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			.theme-links .sep {
				margin: 0 0.35rem;
				color: var(--muted);
			}

			.theme-links button[aria-current="true"] {
				text-decoration: none;
				font-variation-settings: "wght" 700;
			}

			.hero {
				max-width: 46rem;
				margin-bottom: 6rem;
			}

			.hero-line {
				font-size: clamp(1.7rem, 5vw, 2.6rem);
				line-height: 1.15;
				margin: 0 0 2rem;
				font-variation-settings: "wght" 500;
			}

			.hero-line select {
				font: inherit;
				font-variation-settings: "wght" 500;
				background: var(--bg);
				color: var(--fg);
				border: 1px solid var(--line);
				padding: 0.15rem 0.5rem;
				appearance: auto;
				max-width: 100%;
			}

			.tagline {
				font-size: 1.05rem;
				margin: 0 0 1.1rem;
			}

			.subline {
				color: var(--muted);
				max-width: 34rem;
				margin: 0;
			}

			h2.section-label {
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				font-variation-settings: "wght" 700, "MONO" 1;
				margin: 0 0 2rem;
				border-top: 1px solid var(--line);
				padding-top: 1rem;
			}

			section {
				margin-bottom: 5.5rem;
			}

			.latest p {
				max-width: 42rem;
				margin: 0;
			}

			.case-list {
				display: flex;
				flex-direction: column;
			}

			.case-row {
				font: inherit;
				color: inherit;
				background: none;
				border: none;
				border-top: 1px solid var(--line);
				text-align: left;
				width: 100%;
				padding: 1.5rem 0;
				cursor: zoom-in;
				display: grid;
				grid-template-columns: 2.5rem 1fr auto;
				gap: 0.75rem;
				align-items: baseline;
			}

			.case-list .case-row:last-child {
				border-bottom: 1px solid var(--line);
			}

			.case-row:hover .case-title {
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.case-row:focus-visible {
				outline: 1px dashed var(--line);
				outline-offset: 4px;
			}

			.case-no {
				font-variation-settings: "MONO" 1;
				color: var(--muted);
			}

			.case-title {
				font-variation-settings: "wght" 600;
			}

			.case-tag {
				font-variation-settings: "MONO" 1;
				font-size: 0.8rem;
				color: var(--muted);
				white-space: nowrap;
			}

			.case-summary {
				grid-column: 2 / 4;
				color: var(--muted);
				font-size: 0.9rem;
				margin-top: 0.4rem;
			}

			table.listing {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.9rem;
			}

			table.listing th {
				text-align: left;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-variation-settings: "wght" 700, "MONO" 1;
				border-bottom: 1px solid var(--line);
				padding: 0 0.75rem 0.75rem 0;
			}

			table.listing td {
				border-bottom: 1px solid var(--line);
				padding: 1.25rem 0.75rem 1.25rem 0;
				vertical-align: top;
			}

			table.listing img {
				width: 3.5rem;
				height: 3.5rem;
				object-fit: cover;
				display: block;
			}

			table.listing td.detail {
				color: var(--muted);
				max-width: 30rem;
			}

			table.listing td.year {
				font-variation-settings: "MONO" 1;
				color: var(--muted);
				white-space: nowrap;
			}

			.close p {
				max-width: 36rem;
			}

			footer {
				border-top: 1px solid var(--line);
				padding-top: 1rem;
				margin-top: 4rem;
				font-size: 0.8rem;
				color: var(--muted);
				display: flex;
				justify-content: space-between;
			}

			/* Case study window */
			dialog.win {
				position: fixed;
				margin: 0;
				padding: 0;
				top: 10vh;
				left: 50%;
				border: 1px solid var(--line);
				background: var(--bg);
				color: var(--fg);
				width: min(38rem, 90vw);
				height: min(26rem, 78vh);
				min-width: 18rem;
				min-height: 10rem;
				max-width: 96vw;
				max-height: 92vh;
				box-shadow: none;
				border-radius: 0;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}

			dialog.win::backdrop {
				background: transparent;
			}

			dialog.win:not([open]) {
				display: none;
			}

			.win-titlebar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--line);
				padding: 0.5rem 0.75rem;
				cursor: move;
				user-select: none;
				font-variation-settings: "MONO" 1, "wght" 700;
				font-size: 0.75rem;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				flex: 0 0 auto;
			}

			.win-controls {
				display: flex;
				gap: 0.4rem;
				flex: 0 0 auto;
			}

			.win-controls button {
				font: inherit;
				font-size: 0.8rem;
				background: none;
				border: 1px solid var(--line);
				color: inherit;
				width: 1.5rem;
				height: 1.5rem;
				line-height: 1;
				cursor: pointer;
				padding: 0;
			}

			.win-controls button:hover {
				background: var(--fg);
				color: var(--bg);
			}

			.win-body {
				padding: 1.5rem 1.75rem;
				overflow: auto;
				flex: 1;
			}

			.win-tag {
				font-variation-settings: "MONO" 1;
				font-size: 0.8rem;
				color: var(--muted);
				display: block;
				margin-bottom: 1rem;
			}

			.win-body img {
				width: 100%;
				max-width: 22rem;
				display: block;
				margin-bottom: 1rem;
			}

			.win-body p {
				margin: 0;
			}

			.resize-handle {
				position: absolute;
			}

			.rh-n { top: -3px; left: 6px; right: 6px; height: 6px; cursor: ns-resize; }
			.rh-s { bottom: -3px; left: 6px; right: 6px; height: 6px; cursor: ns-resize; }
			.rh-e { top: 6px; bottom: 6px; right: -3px; width: 6px; cursor: ew-resize; }
			.rh-w { top: 6px; bottom: 6px; left: -3px; width: 6px; cursor: ew-resize; }
			.rh-ne { top: -3px; right: -3px; width: 10px; height: 10px; cursor: nesw-resize; }
			.rh-nw { top: -3px; left: -3px; width: 10px; height: 10px; cursor: nwse-resize; }
			.rh-se { bottom: -3px; right: -3px; width: 10px; height: 10px; cursor: nwse-resize; }
			.rh-sw { bottom: -3px; left: -3px; width: 10px; height: 10px; cursor: nesw-resize; }

			@media (prefers-reduced-motion: reduce) {
				* {
					transition: none !important;
				}
			}
		</style>
	</head>
	<body>
		<div class="topbar">
			<span class="topbar-name">Fraser Page</span>
			<span class="theme-links" id="theme-links">
				<button type="button" data-theme-choice="light" aria-current="false">Light</button>
				<span class="sep">/</span>
				<button type="button" data-theme-choice="dark" aria-current="false">Dark</button>
			</span>
		</div>

		<div class="hero">
			<p class="hero-line">
				<select id="trait-select" aria-label="Choose a trait">
					{traits.map((t, i) => (
						<option value={t} selected={i === 0}>{t}</option>
					))}
				</select>
				{" "}
				<select id="role-select" aria-label="Choose a role">
					{roles.map((r, i) => (
						<option value={r} selected={i === 0}>{r}</option>
					))}
				</select>
			</p>
			<p class="tagline">Throw me your fuzziest briefs. (What? No, not underpants.)</p>
			<p class="subline">I start with the data, not assumptions, then build the elegant version, front to back.</p>
		</div>

		<section class="latest">
			<h2 class="section-label">Latest</h2>
			<p>Most recently, I led development on Grace, an AI-native platform advisers use to support hundreds of thousands of students nationally through the college application process &mdash; hundreds of advisers use it day to day. Built for a client with no in-house product team, working alongside Springloaded's design team on everything from a greenfield student portal to an AI assistant to the adviser tools below.</p>
		</section>

		<section class="case-studies">
			<h2 class="section-label">Case studies</h2>
			<div class="case-list">
				{caseStudies.map((c, i) => (
					<button type="button" class="case-row" data-case-index={i}>
						<span class="case-no">{c.no}</span>
						<span class="case-title">{c.title}</span>
						<span class="case-tag">{c.tag}</span>
						<span class="case-summary">{c.summary}</span>
					</button>
				))}
			</div>
		</section>

		<section class="heritage">
			<h2 class="section-label">Heritage</h2>
			<table class="listing">
				<thead>
					<tr>
						<th></th>
						<th>Project</th>
						<th>Detail</th>
						<th>Year</th>
					</tr>
				</thead>
				<tbody>
					{heritage.map((h) => (
						<tr>
							<td><img src={h.img} alt={h.title} /></td>
							<td><a href={h.link} target="_blank" rel="noopener noreferrer">{h.title}</a></td>
							<td class="detail">{h.detail}</td>
							<td class="year">{h.year}</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>

		<section class="personal">
			<h2 class="section-label">Craft &amp; experiments</h2>
			<table class="listing">
				<tbody>
					{personal.map((p) => (
						<tr>
							<td><img src={p.img} alt={p.title} /></td>
							<td><a href={p.link} target="_blank" rel="noopener noreferrer">{p.title}</a></td>
							<td class="detail">{p.detail}</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>

		<section class="close">
			<h2 class="section-label">Get in touch</h2>
			<p>I'm looking for a team that cares as much about the decision as the delivery &mdash; where design carries real weight, and there's room to grow past &ldquo;developer.&rdquo; If that sounds like your team: <a href="mailto:fp@fraser.page">fp@fraser.page</a></p>
		</section>

		<footer>
			<span>Toronto, Canada (Remote)</span>
			<span>Built by Fraser Page</span>
		</footer>

		<dialog class="win" id="case-window">
			<div class="win-titlebar" id="win-titlebar">
				<span id="win-title">Case study</span>
				<div class="win-controls">
					<button type="button" id="win-maximize" aria-label="Maximize">&#9744;</button>
					<button type="button" id="win-close" aria-label="Close">&times;</button>
				</div>
			</div>
			<div class="win-body">
				<span class="win-tag" id="win-tag"></span>
				<img id="win-img" alt="" />
				<p id="win-copy"></p>
			</div>
			<div class="resize-handle rh-n" data-dir="n"></div>
			<div class="resize-handle rh-s" data-dir="s"></div>
			<div class="resize-handle rh-e" data-dir="e"></div>
			<div class="resize-handle rh-w" data-dir="w"></div>
			<div class="resize-handle rh-ne" data-dir="ne"></div>
			<div class="resize-handle rh-nw" data-dir="nw"></div>
			<div class="resize-handle rh-se" data-dir="se"></div>
			<div class="resize-handle rh-sw" data-dir="sw"></div>
		</dialog>

		<script define:vars={{ caseStudies }}>
			const traitSelect = document.getElementById("trait-select");
			const roleSelect = document.getElementById("role-select");

			function persistHeadline() {
				try {
					localStorage.setItem("fp:trait", traitSelect.value);
					localStorage.setItem("fp:role", roleSelect.value);
				} catch (e) {}
			}

			traitSelect?.addEventListener("change", persistHeadline);
			roleSelect?.addEventListener("change", persistHeadline);

			try {
				const savedTrait = localStorage.getItem("fp:trait");
				const savedRole = localStorage.getItem("fp:role");
				if (savedTrait) traitSelect.value = savedTrait;
				if (savedRole) roleSelect.value = savedRole;
			} catch (e) {}

			const root = document.documentElement;
			const themeButtons = document.querySelectorAll("[data-theme-choice]");

			function applyTheme(mode) {
				if (mode === "light" || mode === "dark") {
					root.setAttribute("data-theme", mode);
				} else {
					root.removeAttribute("data-theme");
				}
				themeButtons.forEach((b) => {
					b.setAttribute("aria-current", String(b.getAttribute("data-theme-choice") === mode));
				});
				try {
					localStorage.setItem("fp:theme", mode);
				} catch (e) {}
			}

			themeButtons.forEach((b) => {
				b.addEventListener("click", () => applyTheme(b.getAttribute("data-theme-choice")));
			});

			try {
				const savedTheme = localStorage.getItem("fp:theme");
				if (savedTheme) applyTheme(savedTheme);
			} catch (e) {}

			// Case study window
			const win = document.getElementById("case-window");
			const titlebar = document.getElementById("win-titlebar");
			const maximizeBtn = document.getElementById("win-maximize");
			const closeBtn = document.getElementById("win-close");
			const winTitle = document.getElementById("win-title");
			const winTag = document.getElementById("win-tag");
			const winImg = document.getElementById("win-img");
			const winCopy = document.getElementById("win-copy");

			let restoreRect = null;

			function openCase(index) {
				const c = caseStudies[index];
				winTitle.textContent = c.no + " — " + c.title;
				winTag.textContent = c.tag;
				winImg.src = c.img;
				winImg.alt = c.title;
				winCopy.textContent = c.body;
				win.classList.remove("maximized");

				const w = Math.min(608, window.innerWidth * 0.9);
				const h = Math.min(416, window.innerHeight * 0.78);
				win.style.width = w + "px";
				win.style.height = h + "px";
				win.style.left = (window.innerWidth - w) / 2 + "px";
				win.style.top = Math.max(24, (window.innerHeight - h) / 2) + "px";

				if (!win.open) win.showModal();
			}

			document.querySelectorAll(".case-row").forEach((row) => {
				row.addEventListener("click", () => openCase(Number(row.dataset.caseIndex)));
			});

			closeBtn.addEventListener("click", () => win.close());

			maximizeBtn.addEventListener("click", () => {
				if (!restoreRect) {
					restoreRect = {
						top: win.style.top,
						left: win.style.left,
						width: win.style.width,
						height: win.style.height,
					};
					win.style.top = "3vh";
					win.style.left = "3vw";
					win.style.width = "94vw";
					win.style.height = "94vh";
				} else {
					win.style.top = restoreRect.top;
					win.style.left = restoreRect.left;
					win.style.width = restoreRect.width;
					win.style.height = restoreRect.height;
					restoreRect = null;
				}
			});

			win.addEventListener("close", () => {
				restoreRect = null;
			});

			// Drag to move via titlebar
			titlebar.addEventListener("pointerdown", (e) => {
				if (e.target.closest("button")) return;
				const startX = e.clientX;
				const startY = e.clientY;
				const startTop = win.offsetTop;
				const startLeft = win.offsetLeft;
				restoreRect = null;

				function onMove(ev) {
					win.style.left = startLeft + (ev.clientX - startX) + "px";
					win.style.top = Math.max(0, startTop + (ev.clientY - startY)) + "px";
				}
				function onUp() {
					document.removeEventListener("pointermove", onMove);
					document.removeEventListener("pointerup", onUp);
				}
				document.addEventListener("pointermove", onMove);
				document.addEventListener("pointerup", onUp);
			});

			// Resize via edge/corner handles
			document.querySelectorAll(".resize-handle").forEach((handle) => {
				handle.addEventListener("pointerdown", (e) => {
					e.preventDefault();
					const dir = handle.dataset.dir;
					const startX = e.clientX;
					const startY = e.clientY;
					const startW = win.offsetWidth;
					const startH = win.offsetHeight;
					const startTop = win.offsetTop;
					const startLeft = win.offsetLeft;
					restoreRect = null;

					function onMove(ev) {
						const dx = ev.clientX - startX;
						const dy = ev.clientY - startY;
						if (dir.includes("e")) win.style.width = Math.max(288, startW + dx) + "px";
						if (dir.includes("s")) win.style.height = Math.max(160, startH + dy) + "px";
						if (dir.includes("w")) {
							const nw = Math.max(288, startW - dx);
							win.style.width = nw + "px";
							win.style.left = startLeft + (startW - nw) + "px";
						}
						if (dir.includes("n")) {
							const nh = Math.max(160, startH - dy);
							win.style.height = nh + "px";
							win.style.top = startTop + (startH - nh) + "px";
						}
					}
					function onUp() {
						document.removeEventListener("pointermove", onMove);
						document.removeEventListener("pointerup", onUp);
					}
					document.addEventListener("pointermove", onMove);
					document.addEventListener("pointerup", onUp);
				});
			});
		</script>
	</body>
</html>
