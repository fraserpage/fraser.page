---
import Base from "../layouts/Base.astro";
import { caseStudies } from "../data/caseStudies";

const heritage = [
	{
		thumb: "/images/translash-thumb.jpg",
		peek: "/images/translash-peek.jpg",
		title: "D3 charts + a Webby",
		year: "2024",
		detail: "Lead developer on TransLash. 2025 Webby Award. Legislation-tracking dashboard pulling daily from an external API into interactive D3 charts.",
		link: "https://translash.org/",
	},
	{
		thumb: "/images/chartlabels-thumb.jpg",
		peek: "/images/chartlabels-peek.jpg",
		title: "Chart labels that don't overlap",
		year: "2024",
		detail: "When Chart.js couldn't place doughnut-chart labels without overlap, I wrote the placement geometry myself.",
		link: "https://helpstpauls.com/annual-report/#by-the-numbers",
	},
	{
		thumb: "/images/acumen-thumb.jpg",
		peek: "/images/acumen-peek.jpg",
		title: "Vue map app on a custom WP API",
		year: "2023",
		detail: "Multi-component Vue.js app plotting Acumen’s global programs and portfolio companies, backed by a WordPress REST API I built.",
		link: "https://acumen.org/where-we-work/",
	},
	{
		thumb: "/images/artsmidwest-thumb.jpg",
		peek: "/images/artsmidwest-peek.jpg",
		title: "Grantee impact, mapped",
		year: "2023",
		detail: "Custom REST API powering an interactive SVG map of grantee impact across the region.",
		link: "https://artsmidwest.org/impact/",
	},
];

const personal = [
	{
		thumb: "/images/wedding-thumb.jpg",
		peek: "/images/wedding-peek.jpg",
		title: "Wedding RSVP",
		detail: "An RSVP site for my wedding — one of my favourite things I've built. Kasia and I watch your mouse move around the page and kiss if you shoot an arrow through a heart. Plus custom guest links and a save-as-you-go form.",
		link: "https://kasia-fraser.love/rsvp/v4jXBVDBjTyz7YDY9vDxVjmm",
	},
];
---

<Base>
	<div class="mb-22 max-w-[46rem]">
		<div class="flex items-center gap-8">
			<img
				class="size-32 shrink-0 rounded-full object-cover"
				src="/images/fraser.jpg"
				alt="Fraser Page"
				width="256"
				height="256"
			/>
			<div>
				<h1
					class="m-0 text-[clamp(2.2rem,5vw,3.5rem)] leading-[1.12] tracking-[-0.01em] fv-600"
				>
					Product-minded, AI-native developer.
				</h1>
				<p class="pt-4">I&rsquo;m smart, and am nice to work with.</p>
			</div>
		</div>
	</div>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-[clamp(38rem,80vw,52rem)] pl-16 max-[640px]:pl-0"
		>
			<h2
				class="mb-[1.1rem] block text-[0.8rem] tracking-[0.06em] uppercase fv-mono-600"
			>
				Recently
			</h2>
			<p class="m-0 text-base leading-[1.4]">
				For the last two years I&rsquo;ve worked at <a
					href="https://springloaded.co/"
					target="_blank">Springloaded</a
				> on <a href="https://collegeadvisingcorps.org/" target="_blank"
					>College Advising Corps&rsquo;</a
				> GRACE platform, used by hundreds of advisers across the US to support
				hundreds of thousands of students through the college application
				process. It&rsquo;s a recently rewritten, data-intensive Laravel/Vue/TS
				platform. I grew into the lead developer role and worked directly
				with the client, often in a pseudo&#8209;product&#8209;manager capacity.
				One of my big projects was turning the students GRACE served into
				users of it, which included an AI build-out: a chat agent over SMS
				and web, AI-driven bulk messaging, a scoped RAG knowledge base, and
				an agent toolset for retrieving and modifying student records.
			</p>
		</div>
	</section>
	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-[clamp(38rem,80vw,52rem)] pl-16 max-[640px]:pl-0"
		>
			<h2
				class="mb-[1.1rem] block text-[0.8rem] tracking-[0.06em] uppercase fv-mono-600"
			>
				Case Studies
			</h2>
			<p class="m-0 text-base leading-[1.4]">
				Things I worked on at Springloaded. The idea is to give you a
				sense of how i think.
			</p>
		</div>
		<div class="flex flex-col">
			{
				caseStudies.map((c) => (
					<a
						class="group grid grid-cols-1 items-baseline gap-x-5 gap-y-[0.4rem] border-t border-border py-7 text-inherit no-underline last:border-b focus-dash min-[641px]:grid-cols-[2.75rem_1fr_auto] min-[641px]:gap-y-0 min-[941px]:grid-cols-[2.75rem_3fr_3fr_5fr]"
						href={`/case-studies/${c.slug}/`}
					>
						<span class="text-[0.85rem] text-muted fv-mono">
							{c.no}
						</span>
						<span class="text-xl fv-600 group-hover:underline group-hover:underline-offset-[3px]">
							{c.title}
						</span>
						<span class="col-start-1 text-left text-[0.78rem] tracking-[0.04em] whitespace-normal text-accent uppercase fv-mono-600 min-[641px]:col-start-3 min-[641px]:text-right min-[641px]:whitespace-nowrap min-[941px]:col-start-auto min-[941px]:text-left min-[941px]:whitespace-normal">
							{c.tag}
						</span>
						<span class="col-start-1 text-[0.95rem] text-muted min-[641px]:col-start-2 min-[641px]:col-end-4 min-[641px]:mt-2 min-[941px]:col-start-auto min-[941px]:col-end-auto min-[941px]:mt-0">
							{c.summary}
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-[clamp(38rem,80vw,52rem)] pl-16 max-[640px]:pl-0"
		>
			<h2
				class="mb-[1.1rem] block text-[0.8rem] tracking-[0.06em] uppercase fv-mono-600"
			>
				Heritage
			</h2>
			<p class="m-0 text-base leading-[1.4]">
				Before Springloaded I was at Briteweb, building bespoke sites
				and tools for mission&#8209;driven clients. I enjoy the agency
				model: variety, real problems, greenfields, and a stack of
				finished things to be proud of at the end.
			</p>
		</div>
		<div class="flex flex-col">
			{
				heritage.map((h) => (
					<a
						class="group/row grid grid-cols-1 items-center gap-x-5 gap-y-[0.4rem] border-t border-border py-6 text-inherit no-underline last:border-b focus-dash min-[641px]:grid-cols-[2.75rem_16rem_1fr_3.5rem] min-[641px]:gap-y-0 min-[641px]:py-[1.1rem]"
						href={h.link}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="group/thumb relative block size-11 max-[640px]:mb-1">
							<img
								class="size-full object-cover"
								src={h.thumb}
								alt={h.title}
								loading="lazy"
							/>
							<span class="pointer-events-none invisible absolute bottom-[calc(100%+0.6rem)] left-[calc(100%+0.6rem)] z-10 size-44 translate-y-1 border border-fg bg-bg opacity-0 transition-[opacity,translate] duration-150 ease-[cubic-bezier(0.25,0.1,0.25,1)] group-focus-visible/row:visible group-focus-visible/row:translate-y-0 group-focus-visible/row:opacity-100 max-[640px]:hidden fine:group-hover/thumb:visible fine:group-hover/thumb:translate-y-0 fine:group-hover/thumb:opacity-100">
								<img
									class="size-full object-cover"
									src={h.peek}
									alt=""
									loading="lazy"
								/>
							</span>
						</span>
						<span class="text-[0.95rem] fv-600 group-hover/row:underline group-hover/row:underline-offset-[3px]">
							{h.title}
						</span>
						<span class="text-[0.9rem] text-muted">{h.detail}</span>
						<span class="text-left text-[0.85rem] whitespace-nowrap text-muted fv-mono min-[641px]:text-right">
							{h.year}
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-[clamp(38rem,80vw,52rem)] pl-16 max-[640px]:pl-0"
		>
			<h2
				class="mb-[1.1rem] block text-[0.8rem] tracking-[0.06em] uppercase fv-mono-600"
			>
				Play
			</h2>
			<p class="m-0 text-base leading-[1.4]">A labour of love.</p>
		</div>
		<div class="flex flex-col">
			{
				personal.map((p) => (
					<a
						class="group/row grid grid-cols-1 items-center gap-x-5 gap-y-[0.4rem] border-t border-border py-6 text-inherit no-underline last:border-b focus-dash min-[641px]:grid-cols-[2.75rem_16rem_1fr] min-[641px]:gap-y-0 min-[641px]:py-[1.1rem]"
						href={p.link}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="group/thumb relative block size-11 max-[640px]:mb-1">
							<img
								class="size-full object-cover"
								src={p.thumb}
								alt={p.title}
								loading="lazy"
							/>
							<span class="pointer-events-none invisible absolute bottom-[calc(100%+0.6rem)] left-[calc(100%+0.6rem)] z-10 size-44 translate-y-1 border border-fg bg-bg opacity-0 transition-[opacity,translate] duration-150 ease-[cubic-bezier(0.25,0.1,0.25,1)] group-focus-visible/row:visible group-focus-visible/row:translate-y-0 group-focus-visible/row:opacity-100 max-[640px]:hidden fine:group-hover/thumb:visible fine:group-hover/thumb:translate-y-0 fine:group-hover/thumb:opacity-100">
								<img
									class="size-full object-cover"
									src={p.peek}
									alt=""
									loading="lazy"
								/>
							</span>
						</span>
						<span class="text-[0.95rem] fv-600 group-hover/row:underline group-hover/row:underline-offset-[3px]">
							{p.title}
						</span>
						<span class="text-[0.9rem] text-muted">{p.detail}</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-0 max-w-[clamp(38rem,80vw,52rem)] pl-16 max-[640px]:pl-0"
		>
			<h2
				class="mb-[1.1rem] block text-[0.8rem] tracking-[0.06em] uppercase fv-mono-600"
			>
				Get in touch
			</h2>
			<p class="m-0 text-base leading-[1.4]">
				I&rsquo;m happiest contributing holistically, from thinking
				through the brief while it&rsquo;s still fuzzy to the last bit
				of polish. So I&rsquo;m looking for a team that cares as much
				about the decision as the delivery: where design carries real
				weight, and there&rsquo;s room to grow past
				&ldquo;developer.&rdquo; If that sounds like yours: <a
					href="mailto:fp@fraser.page">fp@fraser.page</a
				>
			</p>
		</div>
	</section>
</Base>
