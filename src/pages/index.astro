---
import Base from "../layouts/Base.astro";
import { caseStudies } from "../data/caseStudies";

const heritage = [
  {
    thumb: "/images/translash-thumb.jpg",
    peek: "/images/translash-peek.jpg",
    title: "D3 charts + a Webby",
    year: "2024",
    detail: "Lead developer on TransLash. 2025 Webby Award. Legislation-tracking dashboard pulling daily from an external API into interactive D3 charts.",
    link: "https://translash.org/",
  },
  {
    thumb: "/images/chartlabels-thumb.jpg",
    peek: "/images/chartlabels-peek.jpg",
    title: "Chart labels that don't overlap",
    year: "2024",
    detail: "When Chart.js couldn't place doughnut-chart labels without overlap, I wrote the placement geometry myself.",
    link: "https://helpstpauls.com/annual-report/#by-the-numbers",
  },
  {
    thumb: "/images/acumen-thumb.jpg",
    peek: "/images/acumen-peek.jpg",
    title: "Rich Vue interactivity backed by internal APIs",
    year: "2023",
    detail: "Custom WordPress REST API and a multi-component Vue.js map app for global programs and portfolio companies.",
    link: "https://acumen.org/where-we-work/",
  },
  {
    thumb: "/images/artsmidwest-thumb.jpg",
    peek: "/images/artsmidwest-peek.jpg",
    title: "Interactive SVG map",
    year: "2023",
    detail: "Award-winning site; custom REST API powering an interactive SVG grantee-impact map.",
    link: "https://artsmidwest.org/impact/",
  },
];

const personal = [
  {
    thumb: "/images/wedding-thumb.jpg",
    peek: "/images/wedding-peek.jpg",
    title: "Wedding RSVP",
    detail: "A playful RSVP site for my own wedding — Kasia and I follow your mouse around the page and kiss if you shoot an arrow through a heart. Plus custom guest links with a save-as-you-go RSVP form.",
    link: "https://kasia-fraser.love/rsvp/v4jXBVDBjTyz7YDY9vDxVjmm",
  },
];
---

<Base>
	<div class="hero">
		<h1>Product-minded, AI-native developer.</h1>
	</div>

	<section id="recent-work" class="section">
		<div class="section-intro">
			<h2 class="label">Recent Work</h2>
			<p>Two years at Springloaded on College Advising Corps&rsquo; GRACE platform, used by hundreds advisers across the states to support hundreds of thousands of students through the college application process. It&rsquo;s a recently rewritten data-intensive Laravel/Vue/TS platform, and is highly dynamic. I grew into the lead developer role, worked directly with the client in a pseudo&#8209;product&#8209;manager capacity. One of my big projects was extending it to turn those served students into users, building out an extensive AI layer to do so. That included a chat agent over SMS and web, with AI driven bulk messaging, a scoped RAG knowledge base, and an agent toolset for retrieving and modifying student records. The case studies below detail some of that work.</p>
		</div>

		<div class="work-list">
			{caseStudies.map((c) => (
				<a class="work-row" href={`/case-studies/${c.slug}/`}>
					<span class="work-no">{c.no}</span>
					<span class="work-title">{c.title}</span>
					<span class="work-tag">{c.tag}</span>
					<span class="work-summary">{c.summary}</span>
				</a>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-intro">
			<h2 class="label">Heritage</h2>
			<p>Before Springloaded I was at Briteweb, building bespoke sites and tools for mission&#8209;driven clients. I enjoy the agency model: variety, real problems, greenfields, and a stack of finished things to be proud of at the end.</p>
		</div>
		<div class="listing-list">
			{heritage.map((h) => (
				<a class="listing-row" href={h.link} target="_blank" rel="noopener noreferrer">
					<span class="listing-thumb">
						<img src={h.thumb} alt={h.title} loading="lazy" />
						<span class="listing-peek"><img src={h.peek} alt="" loading="lazy" /></span>
					</span>
					<span class="listing-name">{h.title}</span>
					<span class="listing-detail">{h.detail}</span>
					<span class="listing-year">{h.year}</span>
				</a>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-intro">
			<h2 class="label">Play</h2>
			<p>A personal project. I wanted our RSVP to feel like us, so I built it.</p>
		</div>
		<div class="listing-list">
			{personal.map((p) => (
				<a class="listing-row no-year" href={p.link} target="_blank" rel="noopener noreferrer">
					<span class="listing-thumb">
						<img src={p.thumb} alt={p.title} loading="lazy" />
						<span class="listing-peek"><img src={p.peek} alt="" loading="lazy" /></span>
					</span>
					<span class="listing-name">{p.title}</span>
					<span class="listing-detail">{p.detail}</span>
				</a>
			))}
		</div>
	</section>

	<section class="section close">
		<div class="section-intro" style="margin-bottom: 0;">
			<h2 class="label">Get in touch</h2>
			<p>I&rsquo;m happiest contributing holistically &mdash; from thinking through the brief while it&rsquo;s still fuzzy, to the last bit of polish. So I&rsquo;m looking for a team that cares as much about the decision as the delivery: where design carries real weight, and there&rsquo;s room to grow past &ldquo;developer.&rdquo; If that sounds like yours: <a href="mailto:fp@fraser.page">fp@fraser.page</a></p>
		</div>
	</section>
</Base>

<style>
	.hero {
		max-width: 46rem;
		margin-bottom: 5.5rem;
	}

	.hero h1 {
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		line-height: 1.12;
		font-variation-settings: "wght" 600;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.work-list {
		display: flex;
		flex-direction: column;
	}

	.work-row {
		display: grid;
		grid-template-columns: 2.75rem 3fr 3fr 5fr;
		column-gap: 1.25rem;
		align-items: baseline;
		border-top: 1px solid var(--border);
		padding: 1.75rem 0;
		text-decoration: none;
		color: inherit;
	}

	.work-list .work-row:last-child {
		border-bottom: 1px solid var(--border);
	}

	.work-row:hover .work-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.work-row:focus-visible {
		outline: 1px dashed var(--fg);
		outline-offset: 4px;
	}

	.work-no {
		font-variation-settings: "MONO" 1;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.work-title {
		font-size: 1.25rem;
		font-variation-settings: "wght" 600;
	}

	.work-tag {
		font-size: 0.78rem;
		color: var(--accent);
		font-variation-settings: "MONO" 1, "wght" 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.work-summary {
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* Medium screens: number/title/tag stay on one line, summary wraps below */
	@media (max-width: 940px) {
		.work-row {
			grid-template-columns: 2.75rem 1fr auto;
		}

		.work-tag {
			grid-column: 3;
			white-space: nowrap;
			text-align: right;
		}

		.work-summary {
			grid-column: 2 / 4;
			margin-top: 0.5rem;
		}
	}

	@media (max-width: 640px) {
		.work-row {
			grid-template-columns: 1fr;
			row-gap: 0.4rem;
		}

		.work-tag {
			grid-column: 1;
			text-align: left;
			white-space: normal;
		}

		.work-summary {
			grid-column: 1;
		}
	}

	.listing-list {
		display: flex;
		flex-direction: column;
	}

	.listing-row {
		display: grid;
		grid-template-columns: 2.75rem 16rem 1fr 3.5rem;
		column-gap: 1.25rem;
		align-items: center;
		border-top: 1px solid var(--border);
		padding: 1.1rem 0;
		text-decoration: none;
		color: inherit;
	}

	.listing-row.no-year {
		grid-template-columns: 2.75rem 16rem 1fr;
	}

	.listing-list .listing-row:last-child {
		border-bottom: 1px solid var(--border);
	}

	.listing-row:hover .listing-name {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.listing-row:focus-visible {
		outline: 1px dashed var(--fg);
		outline-offset: 4px;
	}

	.listing-thumb {
		position: relative;
		display: block;
		width: 2.75rem;
		height: 2.75rem;
	}

	.listing-thumb > img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.listing-peek {
		position: absolute;
		left: calc(100% + 0.6rem);
		bottom: calc(100% + 0.6rem);
		width: 11rem;
		height: 11rem;
		border: 1px solid var(--fg);
		background: var(--bg);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: opacity 0.15s ease, transform 0.15s ease;
		z-index: 10;
		pointer-events: none;
	}

	.listing-peek img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	@media (hover: hover) and (pointer: fine) {
		.listing-thumb:hover .listing-peek,
		.listing-row:focus-visible .listing-peek {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}
	}

	.listing-name {
		font-size: 0.95rem;
		font-variation-settings: "wght" 600;
	}

	.listing-detail {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.listing-year {
		font-variation-settings: "MONO" 1;
		color: var(--muted);
		font-size: 0.85rem;
		white-space: nowrap;
		text-align: right;
	}

	@media (max-width: 640px) {
		.listing-row,
		.listing-row.no-year {
			grid-template-columns: 1fr;
			row-gap: 0.4rem;
			padding: 1.5rem 0;
		}

		.listing-thumb {
			margin-bottom: 0.25rem;
		}

		.listing-peek {
			display: none;
		}

		.listing-year {
			text-align: left;
		}
	}
</style>
