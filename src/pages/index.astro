---
import Base from "../layouts/Base.astro";
import { caseStudies } from "../data/caseStudies";

const heritage = [
	{
		thumb: "/images/translash-thumb.jpg",
		peek: "/images/translash-peek.jpg",
		title: "D3 charts + a Webby",
		year: "2024",
		detail: "Lead developer on TransLash. 2025 Webby Award. Legislation-tracking dashboard pulling daily from an external API into interactive D3 charts.",
		link: "https://translash.org/",
	},
	{
		thumb: "/images/chartlabels-thumb.jpg",
		peek: "/images/chartlabels-peek.jpg",
		title: "Chart labels that don't overlap",
		year: "2024",
		detail: "When Chart.js couldn't place doughnut-chart labels without overlap, I wrote the placement geometry myself.",
		link: "https://helpstpauls.com/annual-report/#by-the-numbers",
	},
	{
		thumb: "/images/acumen-thumb.jpg",
		peek: "/images/acumen-peek.jpg",
		title: "Vue map app on a custom WP API",
		year: "2023",
		detail: "Multi-component Vue.js app plotting Acumen’s global programs and portfolio companies, backed by a WordPress REST API I built.",
		link: "https://acumen.org/where-we-work/",
	},
	{
		thumb: "/images/artsmidwest-thumb.jpg",
		peek: "/images/artsmidwest-peek.jpg",
		title: "Grantee impact, mapped",
		year: "2023",
		detail: "Custom REST API powering an interactive SVG map of grantee impact across the region.",
		link: "https://artsmidwest.org/impact/",
	},
];

const personal = [
	{
		thumb: "/images/wedding-thumb.jpg",
		peek: "/images/wedding-peek.jpg",
		title: "Wedding RSVP",
		detail: "An RSVP site for my wedding — one of my favourite things I've built. Kasia and I watch your mouse move around the page and kiss if you shoot an arrow through a heart. Plus custom guest links and a save-as-you-go form.",
		link: "https://kasia-fraser.love/rsvp/v4jXBVDBjTyz7YDY9vDxVjmm",
	},
];
---

<Base>
	<div class="mb-22 max-w-intro">
		<div class="flex items-center gap-8">
			<img
				class="size-32 shrink-0 rounded-full object-cover"
				src="/images/fraser.jpg"
				alt="Fraser Page"
				width="256"
				height="256"
			/>
			<div>
				<h1
					class="m-0 text-display leading-display tracking-heading fv-600"
				>
					Product-minded, AI-native developer.
				</h1>
				<p class="pt-4">I&rsquo;m smart, and am nice to work with.</p>
			</div>
		</div>
	</div>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-content pl-16 max-sm:pl-0"
		>
			<h2
				class="mb-4.4 block text-label tracking-label uppercase fv-mono-600"
			>
				Recently
			</h2>
			<p class="m-0 text-base leading-intro">
				For the last two years I&rsquo;ve worked at <a
					href="https://springloaded.co/"
					target="_blank">Springloaded</a
				> on <a href="https://collegeadvisingcorps.org/" target="_blank"
					>College Advising Corps&rsquo;</a
				> GRACE platform, used by hundreds of advisers across the US to support
				hundreds of thousands of students through the college application
				process. It&rsquo;s a recently rewritten, data-intensive Laravel/Vue/TS
				platform. I grew into the lead developer role and worked directly
				with the client, often in a pseudo&#8209;product&#8209;manager capacity.
				One of my big projects was turning the students GRACE served into
				users of it, which included an AI build-out: a chat agent over SMS
				and web, AI-driven bulk messaging, a scoped RAG knowledge base, and
				an agent toolset for retrieving and modifying student records.
			</p>
		</div>
	</section>
	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-content pl-16 max-sm:pl-0"
		>
			<h2
				class="mb-4.4 block text-label tracking-label uppercase fv-mono-600"
			>
				Case Studies
			</h2>
			<p class="m-0 text-base leading-intro">
				Things I worked on at Springloaded. I hope they give you some sense of what I&rsquo;m capable of and how i think through a hard problem.
			</p>
		</div>
		<div class="flex flex-col">
			{
				caseStudies.map((c) => (
					<a
						class="group grid grid-cols-1 items-baseline gap-x-5 gap-y-1.6 border-t border-border py-7 text-inherit no-underline last:border-b focus-dash sm:grid-cols-case sm:gap-y-0 wide:grid-cols-case-wide"
						href={`/case-studies/${c.slug}/`}
					>
						<span class="text-meta text-muted fv-mono">
							{c.no}
						</span>
						<span class="text-xl fv-600 group-hover:underline group-hover:underline-offset-3">
							{c.title}
						</span>
						<span class="col-start-1 text-left text-eyebrow tracking-tag whitespace-normal text-accent uppercase fv-mono-600 sm:col-start-3 sm:text-right sm:whitespace-nowrap wide:col-start-auto wide:text-left wide:whitespace-normal">
							{c.tag}
						</span>
						<span class="col-start-1 text-compact text-muted sm:col-start-2 sm:col-end-4 sm:mt-2 wide:col-start-auto wide:col-end-auto wide:mt-0">
							{c.summary}
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-content pl-16 max-sm:pl-0"
		>
			<h2
				class="mb-4.4 block text-label tracking-label uppercase fv-mono-600"
			>
				Heritage
			</h2>
			<p class="m-0 text-base leading-intro">
				Before Springloaded I was at Briteweb, building bespoke sites
				and tools for mission&#8209;driven clients. I enjoy the agency
				model: variety, real problems, greenfields, and a stack of
				finished things to be proud of at the end.
			</p>
		</div>
		<div class="flex flex-col">
			{
				heritage.map((h) => (
					<a
						class="group/row grid grid-cols-1 items-center gap-x-5 gap-y-1.6 border-t border-border py-6 text-inherit no-underline last:border-b focus-dash sm:grid-cols-heritage sm:gap-y-0 sm:py-4.4"
						href={h.link}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="group/thumb relative block size-11 max-sm:mb-1">
							<img
								class="size-full object-cover"
								src={h.thumb}
								alt={h.title}
								loading="lazy"
							/>
							<span class="pointer-events-none invisible absolute bottom-flyout left-flyout z-10 size-44 translate-y-1 border border-fg bg-bg opacity-0 transition-reveal duration-150 ease-standard group-focus-visible/row:visible group-focus-visible/row:translate-y-0 group-focus-visible/row:opacity-100 max-sm:hidden fine:group-hover/thumb:visible fine:group-hover/thumb:translate-y-0 fine:group-hover/thumb:opacity-100">
								<img
									class="size-full object-cover"
									src={h.peek}
									alt=""
									loading="lazy"
								/>
							</span>
						</span>
						<span class="text-compact fv-600 group-hover/row:underline group-hover/row:underline-offset-3">
							{h.title}
						</span>
						<span class="text-detail text-muted">{h.detail}</span>
						<span class="text-left text-meta whitespace-nowrap text-muted fv-mono sm:text-right">
							{h.year}
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-11 max-w-content pl-16 max-sm:pl-0"
		>
			<h2
				class="mb-4.4 block text-label tracking-label uppercase fv-mono-600"
			>
				Play
			</h2>
			<p class="m-0 text-base leading-intro">A labour of love.</p>
		</div>
		<div class="flex flex-col">
			{
				personal.map((p) => (
					<a
						class="group/row grid grid-cols-1 items-center gap-x-5 gap-y-1.6 border-t border-border py-6 text-inherit no-underline last:border-b focus-dash sm:grid-cols-personal sm:gap-y-0 sm:py-4.4"
						href={p.link}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="group/thumb relative block size-11 max-sm:mb-1">
							<img
								class="size-full object-cover"
								src={p.thumb}
								alt={p.title}
								loading="lazy"
							/>
							<span class="pointer-events-none invisible absolute bottom-flyout left-flyout z-10 size-44 translate-y-1 border border-fg bg-bg opacity-0 transition-reveal duration-150 ease-standard group-focus-visible/row:visible group-focus-visible/row:translate-y-0 group-focus-visible/row:opacity-100 max-sm:hidden fine:group-hover/thumb:visible fine:group-hover/thumb:translate-y-0 fine:group-hover/thumb:opacity-100">
								<img
									class="size-full object-cover"
									src={p.peek}
									alt=""
									loading="lazy"
								/>
							</span>
						</span>
						<span class="text-compact fv-600 group-hover/row:underline group-hover/row:underline-offset-3">
							{p.title}
						</span>
						<span class="text-detail text-muted">{p.detail}</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="mb-22 border-t border-border pt-11">
		<div
			class="mb-0 max-w-content pl-16 max-sm:pl-0"
		>
			<h2
				class="mb-4.4 block text-label tracking-label uppercase fv-mono-600"
			>
				Get in touch
			</h2>
			<p class="m-0 text-base leading-intro">
				I&rsquo;m happiest contributing holistically, from thinking
				through the brief while it&rsquo;s still fuzzy to the last bit
				of polish. So I&rsquo;m looking for a team that cares as much
				about the decision as the delivery: where design carries real
				weight, and there&rsquo;s room to grow past
				&ldquo;developer.&rdquo; If that sounds like yours: <a
					href="mailto:fp@fraser.page">fp@fraser.page</a
				>
			</p>
		</div>
	</section>
</Base>
