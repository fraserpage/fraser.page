---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Fraser Page",
	description = "Product-minded, AI-native developer. Case studies and selected product work.",
	image = "/og.png",
} = Astro.props;

const site = Astro.site ?? new URL("https://fraser.page");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---

<html lang="en" class="bg-bg text-fg">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Fraser Page" />
		<meta property="og:locale" content="en_CA" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<title>{title}</title>
	</head>
	<body class="mx-auto max-w-[76rem] bg-bg px-8 pt-10 pb-24 font-sans text-base leading-[1.55] text-fg fv-body">
		<div class="mb-18 flex items-baseline justify-between border-b border-border pb-5 text-[0.85rem]">
			<a class="fv-700 no-underline" href="/">Fraser Page</a>
			<span id="theme-links">
				<button
					type="button"
					data-theme-choice="light"
					aria-current="false"
					class="cursor-pointer text-muted aria-[current=true]:text-fg aria-[current=true]:fv-600"
				>Light</button>
				<span class="mx-[0.35rem] text-muted">/</span>
				<button
					type="button"
					data-theme-choice="dark"
					aria-current="false"
					class="cursor-pointer text-muted aria-[current=true]:text-fg aria-[current=true]:fv-600"
				>Dark</button>
			</span>
		</div>

		<slot />

		<footer class="mt-16 flex justify-between border-t border-border pt-4 text-[0.8rem] text-muted">
			<span>Toronto, Canada (Remote)</span>
			<span>Built by Fraser Page</span>
		</footer>

		<script>
			const root = document.documentElement;
			const themeButtons = document.querySelectorAll("[data-theme-choice]");

			function applyTheme(mode: string) {
				if (mode === "light" || mode === "dark") {
					root.setAttribute("data-theme", mode);
				} else {
					root.removeAttribute("data-theme");
				}
				themeButtons.forEach((b) => {
					b.setAttribute("aria-current", String(b.getAttribute("data-theme-choice") === mode));
				});
				try {
					localStorage.setItem("fp:theme", mode);
				} catch (e) {}
			}

			themeButtons.forEach((b) => {
				b.addEventListener("click", () => applyTheme(b.getAttribute("data-theme-choice") ?? ""));
			});

			try {
				const savedTheme = localStorage.getItem("fp:theme");
				if (savedTheme) applyTheme(savedTheme);
			} catch (e) {}
		</script>
	</body>
</html>
